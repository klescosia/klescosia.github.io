@use "./base.scss";

/* ============================================================
   THE PURPLE CLOUD — autumn-deep brand layer  (v3: honest layout)
   Replaces quartz/styles/custom.scss
   Colors come from theme.colors in quartz.config.ts. This file works
   WITH Quartz's real grid (320 / auto / 320, 6rem top) instead of
   fighting it: one cloud (sidebar title), a constrained reading
   measure, calm type, editorial list/card/callout treatments.
   ============================================================ */

/* ---- Local font faces for Myriad Pro (unchanged) ---- */
@font-face {
  font-family: "Myriad Pro";
  src: url("/static/myriad-pro/Myriad Pro Regular.ttf") format("truetype");
  font-weight: 400; font-style: normal; font-display: swap;
}
@font-face {
  font-family: "Myriad Pro";
  src: url("/static/myriad-pro/Myriad Pro Semibold.ttf") format("truetype");
  font-weight: 600; font-style: normal; font-display: swap;
}
@font-face {
  font-family: "Myriad Pro";
  src: url("/static/myriad-pro/Myriad Pro Bold.ttf") format("truetype");
  font-weight: 700; font-style: normal; font-display: swap;
}
@font-face {
  font-family: "Myriad Pro";
  src: url("/static/myriad-pro/Myriad Pro Italic.ttf") format("truetype");
  font-weight: 400; font-style: italic; font-display: swap;
}
@font-face {
  font-family: "Myriad Pro Light";
  src: url("/static/myriad-pro/Myriad Pro Light.otf") format("opentype");
  font-weight: 400; font-style: normal; font-display: swap;
}

@keyframes pcfloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }

/* ---- Base typography ---- */
body {
  font-family: var(--bodyFont);
  font-weight: 300;
}
h1, h2, h3, h4, h5, h6, strong, a, nav, button, ul, li {
  font-family: var(--headerFont);
  color: var(--dark);
  margin-bottom: 0;
}

/* Heading scale — keep Quartz's own sizes (h1 2rem, h2 1.4rem); only
   tighten tracking so big headings feel composed, not oversized. */
.center h1, article h1 { letter-spacing: -0.02em; }
.center h2, article h2 { letter-spacing: -0.01em; }
.center p, article p   { line-height: 1.75; }

/* ============================================================
   READING MEASURE — keep every center element on one calm column.
   Center DOM: .center > .page-header (breadcrumbs + title)
                        > article (content)
                        > hr
                        > .page-footer (tags + comments)
   ============================================================ */
.center > .page-header,
.center > article,
.center > hr,
.center > .page-footer { max-width: 720px; }
.center > hr { border: none; border-top: 1px solid var(--lightgray); margin: 2rem 0; }

/* ============================================================
   BRAND IDENTITY — sidebar title lockup (the ONE cloud)
   ============================================================ */
.page-title {
  font-weight: 600;
  letter-spacing: -0.01em;
  text-transform: lowercase;
  a {
    display: inline-flex; align-items: center; gap: 0.55rem; color: var(--dark);
    &::before {
      content: ""; width: 1.55rem; height: 1.55rem; flex-shrink: 0;
      background-color: var(--secondary);
      -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>') no-repeat center / contain;
      mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>') no-repeat center / contain;
    }
  }
}

/* ============================================================
   SECTION LABELS  (mono, tracked — "Notes", "dev.to Writing")
   Authored as <p class="pc-section"> so they don't pollute the TOC.
   ============================================================ */
.pc-section {
  font-family: var(--codeFont) !important;
  font-size: 0.74rem !important; font-weight: 500 !important;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--gray) !important; margin: 2.4rem 0 0.7rem !important;
}

/* ============================================================
   NOTE CARDS  (wikilinks rendered as a two-up card row)
   ============================================================ */
.pc-cards ul {
  list-style: none; padding: 0; margin: 0;
  display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;
  @media all and (max-width: 800px) { grid-template-columns: 1fr; }
  li {
    margin: 0;
    a {
      display: block; text-decoration: none;
      background: var(--light); border: 1px solid var(--lightgray);
      border-radius: 11px; padding: 0.85rem 1rem;
      font-size: 0.98rem; font-weight: 600; color: var(--secondary); line-height: 1.3;
      transition: border-color 0.15s ease, transform 0.15s ease;
      &:hover { border-color: var(--secondary); transform: translateY(-2px); }
    }
  }
}

/* ============================================================
   dev.to FEED  (numbered rows with date + tags; auto-filled by
   scripts/fetch-devto.mjs between the index.md markers)
   ============================================================ */
.pc-feed {
  list-style: none; counter-reset: pc; padding: 0; margin: 0;
  li {
    counter-increment: pc;
    border-top: 1px solid var(--lightgray);
    &:last-child { border-bottom: 1px solid var(--lightgray); }
    a {
      display: block; text-decoration: none; position: relative;
      padding: 0.95rem 0 0.95rem 2.6rem;
      &::before {
        content: counter(pc, decimal-leading-zero);
        position: absolute; left: 0; top: 1.05rem;
        font-family: var(--codeFont); font-size: 0.8rem; font-weight: 400; color: var(--secondary);
        transition: transform 0.15s ease;
      }
      &:hover::before { transform: translateX(2px); }
    }
  }
}
.pc-feed-title { display: block; font-weight: 600; color: var(--dark); line-height: 1.32; transition: color 0.15s ease; }
.pc-feed li a:hover .pc-feed-title { color: var(--secondary); }
.pc-ext { color: var(--gray); font-size: 0.8em; }
.pc-feed-meta {
  display: block; margin-top: 0.32rem;
  font-family: var(--codeFont); font-size: 0.72rem; color: var(--gray);
}
.pc-feed-meta time { color: var(--gray); }
.pc-tag { color: var(--secondary); }
.pc-dot { color: var(--lightgray); margin: 0 0.1rem; }

/* ============================================================
   THEMED CALLOUTS  (Quartz [!note] / [!tip] / [!warning] …)
   ============================================================ */
.callout {
  border: 1px solid var(--lightgray);
  border-left: 3px solid var(--callout-color, var(--secondary));
  border-radius: 8px;
  background: color-mix(in srgb, var(--callout-color, var(--secondary)) 7%, var(--light));
}
.callout[data-callout="note"]      { --callout-color: #6e2b63; }
.callout[data-callout="abstract"], .callout[data-callout="tip"],
.callout[data-callout="info"]      { --callout-color: #c4762f; }
.callout[data-callout="warning"], .callout[data-callout="caution"],
.callout[data-callout="failure"], .callout[data-callout="danger"] { --callout-color: #9e2b50; }
.callout[data-callout="success"], .callout[data-callout="question"] { --callout-color: #5c4d7d; }
.callout-title { font-family: var(--codeFont); letter-spacing: 0.03em; }
:root[saved-theme="dark"] {
  .callout[data-callout="note"]      { --callout-color: #cf86c4; }
  .callout[data-callout="abstract"], .callout[data-callout="tip"],
  .callout[data-callout="info"]      { --callout-color: #e0954a; }
  .callout[data-callout="warning"], .callout[data-callout="caution"],
  .callout[data-callout="failure"], .callout[data-callout="danger"] { --callout-color: #d65b86; }
}

/* ============================================================
   GLOBAL LINK / MARK / TAG / QUOTE POLISH
   ============================================================ */
.center, article {
  a:not(.internal):not(.tag-link) {
    color: var(--secondary);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--secondary) 35%, transparent);
    text-underline-offset: 3px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
    &:hover { color: var(--tertiary); text-decoration-color: var(--tertiary); }
  }
  a.internal {
    background-color: var(--highlight); color: var(--secondary);
    padding: 0 0.18em; border-radius: 4px; text-decoration: none;
    &:hover { background-color: color-mix(in srgb, var(--secondary) 16%, transparent); }
  }
}

/* ==marked== / <mark> → gold marker swipe */
mark {
  background: linear-gradient(transparent 58%, var(--textHighlight) 58%);
  color: inherit; padding: 0 2px; border-radius: 0;
}

/* Explorer / TOC headers → mono tracked */
.explorer button#explorer, .toc > button {
  font-family: var(--codeFont) !important;
  font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gray);
}

/* Tags → mono plum pill */
a.tag-link {
  font-family: var(--codeFont); font-size: 0.72rem;
  color: var(--secondary); background: var(--highlight);
  padding: 0.18em 0.55em; border-radius: 6px; text-decoration: none; border: none;
}

/* Blockquotes + inline code */
blockquote { border-left: 3px solid var(--secondary); color: var(--secondary); font-style: italic; }
code { font-family: var(--codeFont); background: var(--highlight); color: var(--secondary); border-radius: 5px; }

/* Search + darkmode toggle rounding */
.search .search-container { border-radius: 14px; }
#search-container .search-button, .darkmode, .search .search-button { border-radius: 10px; }

::selection { background: var(--textHighlight); color: var(--dark); }

/* ============================================================
   404 PAGE  (themed component → quartz/components/pages/404.tsx)
   ============================================================ */
.pc-404 {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; min-height: 52vh; gap: 0.4rem;
  .pc-404-mark { color: var(--secondary); animation: pcfloat 6s ease-in-out infinite; margin-bottom: 0.6rem; }
  h1 { font-size: 4rem; font-weight: 700; letter-spacing: -0.04em; margin: 0; color: var(--dark); }
  .pc-404-lead { font-size: 1.15rem; font-weight: 300; color: var(--gray); max-width: 30rem; margin: 0.2rem 0 1.2rem; }
  a { color: var(--secondary); text-decoration: none; font-weight: 600;
      &:hover { color: var(--tertiary); } }
}

/* Respect reduced-motion */
@media (prefers-reduced-motion: reduce) {
  .pc-404-mark { animation: none; }
  .pc-cards ul li a:hover { transform: none; }
}

/* Amber accent vars (no dedicated Quartz slot) */
:root { --amberchip: #f4e3cf; --ambertext: #a55c1c; }
:root[saved-theme="dark"] { --amberchip: rgba(224,149,74,0.18); --ambertext: #e6a45c; }
