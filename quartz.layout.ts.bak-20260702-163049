import { PageLayout, SharedLayout } from "./quartz/cfg"
import * as Component from "./quartz/components"

/**
 * The Purple Cloud — layout
 * Identical to your original quartz.layout.ts EXCEPT every Explorer now has a
 * `filterFn` that hides the homepage node (slug "index" → the stray
 * "/ Kyle Escosia" entry). Everything else (Comments, Footer, Breadcrumbs…)
 * is unchanged.
 */

// Hide the homepage from the explorer tree; keep Quartz's default tag-folder hide.
const hideHome = (node: any) => {
  const slug = node.file?.slug ?? node.slug
  if (slug === "index") return false
  return node.name !== "tags"
}

const fileMap = (node: any) => {
  if (!node.file) {
    node.displayName = node.displayName
  } else {
    node.displayName = "/ " + node.displayName
  }
}

const listMap = (node: any) => {
  if (!node.file) {
    node.displayName = "📁 " + node.displayName
  } else {
    node.displayName = "📄 " + node.displayName
  }
}

// components shared across all pages
export const sharedPageComponents: SharedLayout = {
  head: Component.Head(),
  header: [],
  afterBody: [],
  footer: Component.Footer({
    links: {
      GitHub: "https://github.com/klescosia",
      RSS: "/index.xml",
    },
  }),
}

// components for pages that display a single page (e.g. a single note)
export const defaultContentPageLayout: PageLayout = {
